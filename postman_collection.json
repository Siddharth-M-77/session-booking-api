  "item": [
    {
      "name": "Teachers",
      "item": [
        {
          "name": "Create Teacher (Extra)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data._id) {",
                  "    pm.collectionVariables.set('teacherId', response.data._id);",
                  "    console.log('Saved teacherId:', response.data._id);",
                  "}",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has success true', () => {",
                  "    pm.expect(response.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Prof. Marie Curie\",\n  \"email\": \"marie.curie@example.com\",\n  \"specialization\": \"Radiochemistry & Physics\",\n  \"experience\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["teachers"]
            }
          }
        },
        {
          "name": "List All Teachers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["teachers"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data._id) {",
                  "    pm.collectionVariables.set('userId', response.data._id);",
                  "    console.log('Saved userId:', response.data._id);",
                  "}",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('User created with correct email', () => {",
                  "    pm.expect(response.data.email).to.eql('john.doe@example.com');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1-555-0199\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Get User Sessions History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains facet structures', () => {",
                  "    pm.expect(response.data).to.have.property('upcomingSessions');",
                  "    pm.expect(response.data).to.have.property('completedSessions');",
                  "    pm.expect(response.data).to.have.property('counts');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "sessions"]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create Session 1 (for booking)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const start = new Date(now.getTime() + 2 * 60 * 60 * 1000);",
                  "const end = new Date(now.getTime() + 3 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('sessionStart', start.toISOString());",
                  "pm.collectionVariables.set('sessionEnd', end.toISOString());",
                  "pm.collectionVariables.set('queryTimestamp', now.getTime().toString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data._id) {",
                  "    pm.collectionVariables.set('sessionId', response.data._id);",
                  "    console.log('Saved sessionId:', response.data._id);",
                  "}",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Status is AVAILABLE', () => {",
                  "    pm.expect(response.data.status).to.eql('AVAILABLE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{sessionStart}}\",\n  \"endTime\": \"{{sessionEnd}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            }
          }
        },
        {
          "name": "Create Session 2 (for complete test)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const start = new Date(now.getTime() + 4 * 60 * 60 * 1000);",
                  "const end = new Date(now.getTime() + 5 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('session2Start', start.toISOString());",
                  "pm.collectionVariables.set('session2End', end.toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data._id) {",
                  "    pm.collectionVariables.set('secondSessionId', response.data._id);",
                  "}",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{session2Start}}\",\n  \"endTime\": \"{{session2End}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            }
          }
        },
        {
          "name": "Get Available Sessions (Aggregation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains aggregation results', () => {",
                  "    pm.expect(response.data).to.have.property('date');",
                  "    pm.expect(response.data).to.have.property('count');",
                  "    pm.expect(response.data).to.have.property('sessions');",
                  "    pm.expect(response.data.sessions).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{queryTimestamp}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "available"],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{queryTimestamp}}"
                }
              ]
            }
          }
        },
        {
          "name": "Book Session (Atomic)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status transitioned to BOOKED', () => {",
                  "    pm.expect(response.data.status).to.eql('BOOKED');",
                  "    pm.expect(response.data.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "book"]
            }
          }
        },
        {
          "name": "Complete Session (Atomic)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status transitioned to COMPLETED with completedAt date', () => {",
                  "    pm.expect(response.data.status).to.eql('COMPLETED');",
                  "    pm.expect(response.data.completedAt).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "complete"]
            }
          }
        }
      ]
    },
